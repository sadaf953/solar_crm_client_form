    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { Customer, Project, StageDefinition, Payment, Financials, SubsidyHistory, BankInfo, FormConfig } from \'./types\';\n\nexport const defaultStages: StageDefinition[] = [\n  { id: \'stage_1\', name: \'Site Survey & Proposal\', description: \'Evaluate site feasibility, structural strength, shadow elements and present final plan.\', order: 1, isSkipable: false },\n  { id: \'stage_2\', name: \'Financial Agreement & Booking\', description: \'Collect advance booking amount and finalize commercial contract terms.\', order: 2, isSkipable: false },\n  { id: \'stage_3\', name: \'DISCOM Feasibility Application\', description: \'Submit feasibility request to the regional distribution company for solar integration.\', order: 3, isSkipable: true },\n  { id: \'stage_4\', name: \'Material Dispatch & Procurement\', description: \'Procure Tier-1 solar panels, inverter, mounting structures, and ACDB/DCDB boxes.\', order: 4, isSkipable: false },\n  { id: \'stage_5\', name: \'Structure Assembly & Panel Mounting\', description: \'Erect hot-dip galvanized or aluminum structural components and mount panels securely.\', order: 5, isSkipable: false },\n  { id: \'stage_6\', name: \'Electrical Wiring & DC/AC Cabling\', description: \'Wire panel strings, connect to inverter, earth pit setup, and route to local distribution board.\', order: 6, isSkipable: false },\n  { id: \'stage_7\', name: \'Net Metering Application & Approval\', description: \'Apply for solar bidirectional meter replacement with regional electricity board.\', order: 7, isSkipable: false },\n  { id: \'stage_8\', name: \'Net Meter Installation\', description: \'Electricity board technician visits, approves connections, and installs Net Meter.\', order: 8, isSkipable: false },\n  { id: \'stage_9\', name: \'Commissioning & Grid Power On\', description: \'Safely activate the system, test output, and hand over the keys and manuals to the customer.\', order: 9, isSkipable: false },\n  { id: \'stage_10\', name: \'Subsidy Claim Submission\', description: \'Upload invoices and commissioning reports to government solar portal for cash subsidy.\', order: 10, isSkipable: true },\n];\n\nexport const initialCustomers: Customer[] = [\n  {\n    id: \'cust_1\',\n    name: \'Rajesh Sharma\',\n    phone: \'+91 98765 43210\',\n    email: \'rajesh.sharma@gmail.com\',\n    aadhar: \'5432-8765-1092\',\n    poc: \'Self\',\n    branch: \'East Delhi Branch\',\n    location: \'New Delhi\',\n    address: \'H-42, Block B, Preet Vihar, New Delhi, 110092\',\n    createdAt: \'2026-06-15T10:00:00Z\'\n  },\n  {\n    id: \'cust_2\',\n    name: \'Anjali Deshmukh\',\n    phone: \'+91 87654 32109\',\n    email: \'anjali_desh@outlook.com\',\n    aadhar: \'9812-3456-7890\',\n    poc: \'Vikram Deshmukh (Spouse)\',\n    branch: \'Pune West\',\n    location: \'Pune\',\n    address: \'Fl. 402, Royal Palms, Baner Road, Pune, 411045\',\n    createdAt: \'2026-06-20T11:30:00Z\'\n  },\n  {\n    id: \'cust_3\',\n    name: \'Greenwood Apparels Pvt Ltd\',\n    phone: \'+91 91234 56789\',\n    email: \'admin@greenwoodapparels.com\',\n    aadhar: \'N/A (Corporate GSTIN: 27AACCG1234F1Z5)\',\n    poc: \'Mr. Satish Nair (Ops Head)\',\n    branch: \'Mumbai Corporate\',\n    location: \'Thane\',\n    address: \'Plot No. 12, Wagle Industrial Estate, Thane West, Maharashtra, 400604\',\n    createdAt: \'2026-06-28T14:15:00Z\'\n  }\n];\n\nexport const initialProjects: Project[] = [\n  {\n    id: \'CRN-2026-0001\',\n    customerId: \'cust_1\',\n    capacityKwp: 5.4,\n    type: \'On-grid\',\n    vendor: \'Tata Power Solar\',\n    meterCat: \'Residential LT\',\n    ebNumber: \'EB-9876543-DL\',\n    dtrCode: \'DTR-PV-08\',\n    sanctionedLoad: \'7 kW\',\n    discomDiv: \'BSES Yamuna\',\n    googleDocsLink: \'https://docs.google.com/document/d/sample-rajesh-sharma\',\n    locationLink: \'https://maps.google.com/?q=28.6384,77.2911\',\n    currentStageId: \'s