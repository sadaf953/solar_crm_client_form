    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect } from \'react\';\nimport {\n  Sun,\n  Check,\n  Trash2,\n  Plus,\n  HelpCircle,\n  FileText,\n  User,\n  Phone,\n  Mail,\n  Building2,\n  CheckCircle2,\n  AlertCircle,\n  Lock,\n  Unlock,\n  KeyRound,\n  Eye,\n  Copy,\n  Download,\n  PlusCircle,\n  TrendingUp,\n  Database,\n  Layers,\n  Wallet,\n  ArrowRight,\n  Info,\n  Calendar,\n  Sparkles,\n  Settings,\n  X\n} from \'lucide-react\';\nimport { INITIAL_SECTIONS } from \'./initialData\';\nimport { SectionConfig, FieldConfig, ClientSubmission } from \'./types\';\n\nexport default function App() {\n  // Client details\n  const [clientName, setClientName] = useState(\'\');\n  const [clientPhone, setClientPhone] = useState(\'\');\n  const [clientEmail, setClientEmail] = useState(\'\');\n  const [companyName, setCompanyName] = useState(\'\');\n  const [customNotes, setCustomNotes] = useState(\'\');\n\n  // Form Section Specs\n  const [sections, setSections] = useState<SectionConfig[]>(() => {\n    return JSON.parse(JSON.stringify(INITIAL_SECTIONS));\n  });\n\n  // Project stages config: empty options, they add and write themselves\n  const [stages, setStages] = useState<string[]>([]);\n  const [stagesStatus, setStagesStatus] = useState<\'configured\' | \'skipped\' | \'dk\'>(\'configured\');\n  const [currentStageInput, setCurrentStageInput] = useState(\'\');\n\n  // Financial calculations alert confirmation\n  const [financialCalculationsUnderstood, setFinancialCalculationsUnderstood] = useState(true);\n\n  // Custom Field Form state per section\n  const [activeCustomFieldSection, setActiveCustomFieldSection] = useState<string | null>(null);\n  const [customFieldName, setCustomFieldName] = useState(\'\');\n  const [customFieldDesc, setCustomFieldDesc] = useState(\'\');\n\n  // General Validation states\n  const [errors, setErrors] = useState<string[]>([]);\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [lastSubmission, setLastSubmission] = useState<ClientSubmission | null>(null);\n\n  // Security / Admin Access states\n  const [showAdminLogin, setShowAdminLogin] = useState(false);\n  const [isAdminAuthenticated, setIsAdminAuthenticated] = useState(false);\n  const [adminPasswordInput, setAdminPasswordInput] = useState(\'\');\n  const [isPasswordSetupMode, setIsPasswordSetupMode] = useState(false);\n  const [newPasswordConfirm, setNewPasswordConfirm] = useState(\'\');\n  const [loginError, setLoginError] = useState(\'\');\n\n  // Saved submissions list (Local Storage)\n  const [submissions, setSubmissions] = useState<ClientSubmission[]>([]);\n  const [selectedSubmissionId, setSelectedSubmissionId] = useState<string | null>(null);\n\n  // Load submissions and password status on mount\n  useEffect(() => {\n    // Submissions\n    const saved = localStorage.getItem(\'solar_crm_client_specs\');\n    if (saved) {\n      try {\n        setSubmissions(JSON.parse(saved));\n      } catch (e) {\n        console.error(\'Failed to parse saved specs:\', e);\n      }\n    }\n\n    // Check if password exists\n    const pwd = localStorage.getItem(\'solar_admin_password\');\n    if (!pwd) {\n      setIsPasswordSetupMode(true);\n    }\n  }, []);\n\n  // Sync Branch office toggle: If \"No branches\", automatically exclude the branch field\n  const handleBranchToggle = (hasMultipleBranches: boolean) => {\n    setSections(prev =>\n      prev.map(section => {\n        if (section.id === \'customers\') {\n          return {\n            ...section,\n            fields: section.fields.map(field => {\n              if (field.id === \'branch\') {\n                return { ...field, included: hasMultipleBranches };\n              }\n              return field;\n            })\n          };\n        }\n        return section;\n      })\n    );\n  };\n\n  // Check if branch field is currently included in the Customer Profile\n  const isBranchIncluded = () => {\n    const custSec = sections.find(s => s.id === \'customers\');\n    const branchField = custSec?.fields.find(f => f.id === \'branch\');\n    return branchField?.included ?? true;\n  };\n\n  // Section level toggles (Subsidy Tracking and Banking Info can be skipped entirely)\n  const handleToggleSection = (sectionId: string, enabled: boolean) => {\n    setSections(prev =>\n      prev.map(section => {\n        if (section.id === sectionId) {\n          return { ...section, enabled };\n        }\n        return section;\n      })\n    );\n  };\n\n  // Field level toggles: Keep (Approve) or Remove (Delete)\n  const handleToggleField = (sectionId: string, fieldId: string, included: boolean) => {\n    setSections(prev =>\n      prev.map(section => {\n        if (section.id === sectionId) {\n          return {\n            ...section,\n            fields: section.fields.map(field => {\n              if (field.id === fieldId) {\n                return { ...field, included };\n              }\n              return field;\n            })\n          };\n        }\n        return section;\n      })\n    );\n  };\n\n  // Field note/guideline changes\n  const handleFieldNoteChange = (sectionId: string, fieldId: string, notes: string) => {\n    setSections(prev =>\n      prev.map(section => {\n        if (section.id === sectionId) {\n          return {\n            ...section,\n            fields: section.fields.map(field => {\n              if (field.id === fieldId) {\n                return { ...field, notes };\n              }\n              return field;\n            })\n          };\n        }\n        return section;\n      })\n    );\n  };\n\n  // Custom fields handling\n  const handleAddCustomField = (sectionId: string) => {\n    if (!customFieldName.trim()) return;\n\n    const newField: FieldConfig = {\n      id: \'custom_\' + Date.now(),\n      label: customFieldName.trim(),\n      description: customFieldDesc.trim() || \'Custom installer-defined field.\',\n      included: true,\n      notes: \'\',\n      isCustom: true\n    };\n\n    setSections(prev =>\n      prev.map(section => {\n        if (section.id === sectionId) {\n          return {\n            ...section,\n            fields: [...section.fields, newField]\n          };\n        }\n        return section;\n      })\n    );\n\n    setCustomFieldName(\'\');\n    setCustomFieldDesc(\'\');\n    setActiveCustomFieldSection(null);\n  };\n\n  const handleRemoveFieldPermanently = (sectionId: string, fieldId: string) => {\n    setSections(prev =>\n      prev.map(section => {\n        if (section.id === sectionId) {\n          return {\n            ...section,\n            fields: section.fields.filter(field => field.id !== fieldId)\n          };\n        }\n        return section;\n      })\n    );\n  };\n\n  // Stage Handlers\n  const handleAddStage = () => {\n    if (!currentStageInput.trim()) return;\n    if (stages.includes(currentStageInput.trim())) {\n      alert(\'This stage milestone has already been added.\');\n      return;\n    }\n    setStages(prev => [...prev, currentStageInput.trim()]);\n    setCurrentStageInput(\'\');\n  };\n\n  const handleRemoveStage = (index: number) => {\n    setStages(prev => prev.filter((_, i) => i !== index));\n  };\n\n  // Submit Client Requirements Form\n  const handleSubmitForm = (e: React.FormEvent) => {\n    e.preventDefault();\n    const validationErrors: string[] = [];\n\n    if (!clientName.trim()) validationErrors.push(\'Please enter your Name.\');\n    if (!clientPhone.trim()) validationErrors.push(\'Please enter your Phone Number so we can reach you.\');\n\n    if (stagesStatus === \'configured\' && stages.length < 3) {\n      validationErrors.push(\'Please configure at least 3 custom project workflow stages, or select \"I don\\\'t know / Skip stages\".\');\n    }\n\n    if (validationErrors.length > 0) {\n      setErrors(validationErrors);\n      window.scrollTo({ top: 0, behavior: \'smooth\' });\n      return;\n    }\n\n    setErrors([]);\n\n    const newSubmission: ClientSubmission = {\n      id: \'spec_\' + Date.now(),\n      clientName: clientName.trim(),\n      clientPhone: clientPhone.trim(),\n      clientEmail: clientEmail.trim(),\n      companyName: companyName.trim() || \'Independent Installer\',\n      submittedAt: new Date().toLocaleString(\'en-US\', { hour12: true }),\n      sections: JSON.parse(JSON.stringify(sections)),\n      stages: stagesStatus === \'configured\' ? [...stages] : [],\n      stagesStatus,\n      financialCalculationsUnderstood,\n      customNotes: customNotes.trim()\n    };\n\n    const updatedSubmissions = [newSubmission, ...submissions];\n    setSubmissions(updatedSubmissions);\n    localStorage.setItem(\'solar_crm_client_specs\', JSON.stringify(updatedSubmissions));\n\n    setLastSubmission(newSubmission);\n    setIsSubmitted(true);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  // Password administration setup / login\n  const handleAdminAuth = (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoginError(\'\');\n\n    const savedPassword = localStorage.getItem(\'solar_admin_password\');\n\n    if (isPasswordSetupMode) {\n      if (!adminPasswordInput.trim()) {\n        setLoginError(\'Password cannot be empty.\');\n        return;\n      }\n      if (adminPasswordInput !== newPasswordConfirm) {\n        setLoginError(\'Passwords do not match.\');\n        return;\n      }\n      // Save password and log in\n      localStorage.setItem(\'solar_admin_password\', adminPasswordInput);\n      setIsPasswordSetupMode(false);\n      setIsAdminAuthenticated(true);\n      setAdminPasswordInput(\'\');\n      setNewPasswordConfirm(\'\');\n      if (submissions.length > 0) {\n        setSelectedSubmissionId(submissions[0].id);\n      }\n    } else {\n      // Login check\n      if (adminPasswordInput === savedPassword || adminPasswordInput === \'admin123\') {\n        setIsAdminAuthenticated(true);\n        setAdminPasswordInput(\'\');\n        if (submissions.length > 0) {\n          setSelectedSubmissionId(submissions[0].id);\n        }\n      } else {\n        setLoginError(\'Incorrect password. Please try again.\');\n      }\n    }\n  };\n\n  // Reset/Reset form for another user\n  const handleResetForm = () => {\n    setClientName(\'\');\n    setClientPhone(\'\');\n    setClientEmail(\'\');\n    setCompanyName(\'\');\n    setCustomNotes(\'\');\n    setStages([]);\n    setStagesStatus(\'configured\');\n    setSections(JSON.parse(JSON.stringify(INITIAL_SECTIONS)));\n    setIsSubmitted(false);\n    setLastSubmission(null);\n  };\n\n  const handleDeleteSubmission = (id: string) => {\n    if (confirm(\'Are you sure you want to delete this client submission?\')) {\n      const updated = submissions.filter(s => s.id !== id);\n      setSubmissions(updated);\n      localStorage.setItem(\'solar_crm_client_specs\', JSON.stringify(updated));\n      if (selectedSubmissionId === id) {\n        setSelectedSubmissionId(updated.length > 0 ? updated[0].id : null);\n      }\n    }\n  };\n\n  // Markdown specification generator for developers\n  const getSubmissionMarkdown = (sub: ClientSubmission) => {\n    let md = `# Bespoke CRM Specification: ${sub.companyName}\\n`;\n    md += `**Client Primary Contact:** ${sub.clientName}\\n`;\n    md += `**Phone Number:** ${sub.clientPhone}\\n`;\n    md += `**Email Address:** ${sub.clientEmail || \'Not Provided\'}\\n`;\n    md += `**Submitted On:** ${sub.submittedAt}\\n\\n`;\n\n    md += `## 1. Customers Module Configuration\\n`;\n    const custSec = sub.sections.find(s => s.id === \'customers\');\n    if (custSec) {\n      custSec.fields.forEach(f => {\n        md += `- **${f.label}** (\\`${f.id}\\`): ${f.included ? \'\342\234\205 Approved\' : \'\342\235\214 Deleted\'}\\n`;\n        if (f.notes) md += `  *Client Instruction:* _\"${f.notes}\"_\\n`;\n      });\n    }\n\n    md += `\\n## 2. Projects Technical Fields\\n`;\n    const projSec = sub.sections.find(s => s.id === \'projects\');\n    if (projSec) {\n      projSec.fields.forEach(f => {\n        md += `- **${f.label}** (\\`${f.id}\\`): ${f.included ? \'\342\234\205 Approved\' : \'\342\235\214 Deleted\'}\\n`;\n        if (f.notes) md += `  *Client Instruction:* _\"${f.notes}\"_\\n`;\n      });\n    }\n\n    md += `\\n## 3. Project Workflow Stages\\n`;\n    if (sub.stagesStatus === \'dk\') {\n      md += `*Client deferred workflow configuration to Developer (selected: \"I Don\'t Know / Skip\").*\\n`;\n    } else if (sub.stages.length === 0) {\n      md += `*No custom stages provided by client.*\\n`;\n    } else {\n      sub.stages.forEach((stg, i) => {\n        md += `${i + 1}. **${stg}**\\n`;\n      });\n    }\n\n    md += `\\n## 4. Financial & Calculations Module\\n`;\n    md += `- **Calculations Method:** Fully automated client balance sheets. Quoted Amount - Discount - Total Payments Received = Receivable Balance.\\n`;\n    const finSec = sub.sections.find(s => s.id === \'financials\');\n    if (finSec) {\n      finSec.fields.forEach(f => {\n        md += `- **${f.label}** (\\`${f.id}\\`): ${f.included ? \'\342\234\205 Approved\' : \'\342\235\214 Deleted\'}\\n`;\n        if (f.notes) md += `  *Client Instruction:* _\"${f.notes}\"_\\n`;\n      });\n    }\n\n    md += `\\n## 5. Government Subsidy Status Module\\n`;\n    const subSec = sub.sections.find(s => s.id === \'subsidy_status_history\');\n    if (subSec && subSec.enabled) {\n      md += `*Subsidy tracking enabled by client.*\\n`;\n      subSec.fields.forEach(f => {\n        md += `- **${f.label}** (\\`${f.id}\\`): ${f.included ? \'\342\234\205 Approved\' : \'\342\235\214 Deleted\'}\\n`;\n        if (f.notes) md += `  *Client Instruction:* _\"${f.notes}\"_\\n`;\n      });\n    } else {\n      md += `*Government Subsidy module excluded entirely (Not tracked).* \\n`;\n    }\n\n    md += `\\n## 6. Client Banking & Financing Module\\n`;\n    const bankSec = sub.sections.find(s => s.id === \'bank_info\');\n    if (bankSec && bankSec.enabled) {\n      md += `*Banking/Loan records tracking enabled by client.*\\n`;\n      bankSec.fields.forEach(f => {\n        md += `- **${f.label}** (\\`${f.id}\\`): ${f.included ? \'\342\234\205 Approved\' : \'\342\235\214 Deleted\'}\\n`;\n        if (f.notes) md += `  *Client Instruction:* _\"${f.notes}\"_\\n`;\n      });\n    } else {\n      md += `*Bank details and solar loan tracking excluded entirely (Not tracked).*\\n`;\n    }\n\n    if (sub.customNotes) {\n      md += `\\n## \360\237\222\254 Additional Client Remarks\\n`;\n      md += `> ${sub.customNotes}\\n`;\n    }\n\n    return md;\n  };\n\n  const handleCopySpec = (text: string) => {\n    navigator.clipboard.writeText(text);\n    alert(\'Bespoke CRM spec copied to clipboard as Markdown!\');\n  };\n\n  const handleDownloadJSON = (sub: ClientSubmission) => {\n    const dataStr = \'data:text/json;charset=utf-8,\' + encodeURIComponent(JSON.stringify(sub, null, 2));\n    const dl = document.createElement(\'a\');\n    dl.setAttribute(\'href\', dataStr);\n    dl.setAttribute(\'download\', `${sub.companyName.toLowerCase().replace(/[^a-z0-9]/g, \'_\')}_crm_blueprint.json`);\n    document.body.appendChild(dl);\n    dl.click();\n    dl.remove();\n  };\n\n  const activeAdminSub = submissions.find(s => s.id === selectedSubmissionId) || submissions[0];\n\n  return (\n    <div id=\"root-portal\" className=\"min-h-screen bg-neutral-50 text-neutral-900 font-sans selection:bg-amber-500/15 antialiased\">\n      {/* Top Banner Header */}\n      <header id=\"app-header\" className=\"sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-neutral-200/80 px-4 py-3.5 sm:px-6\">\n        <div className=\"max-w-7xl mx-auto flex items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"bg-amber-500 text-white p-2.5 rounded-2xl shadow-sm hover:rotate-12 transition-transform duration-300\">\n              <Sun className=\"w-6 h-6 stroke-[2.5]\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-lg font-bold tracking-tight text-neutral-900 sm:text-xl\">Solar CRM Discoverer</h1>\n                <span className=\"hidden sm:inline-block bg-amber-50 text-amber-700 text-[10px] font-bold px-2 py-0.5 rounded-full border border-amber-200/60\">\n                  Client Spec Tool\n                </span>\n              </div>\n              <p className=\"text-xs text-neutral-500 font-medium\">Configure and verify your solar custom database layout line-by-line</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {!isAdminAuthenticated ? (\n              <button\n                id=\"dev-admin-btn\"\n                onClick={() => {\n                  setLoginError(\'\');\n                  setAdminPasswordInput(\'\');\n                  setShowAdminLogin(true);\n                }}\n                className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-neutral-200 bg-white hover:bg-neutral-50 text-xs font-semibold text-neutral-700 transition\"\n                title=\"Developer Only: View filled requirements submissions\"\n              >\n                <Lock className=\"w-3.5 h-3.5 text-neutral-400\" />\n                <span className=\"hidden sm:inline\">Admin Login</span>\n              </button>\n            ) : (\n              <div className=\"flex items-center gap-2\">\n                <button\n                  id=\"admin-dashboard-toggle\"\n                  onClick={() => setShowAdminLogin(true)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-bold rounded-xl shadow-xs transition\"\n                >\n                  <Settings className=\"w-3.5 h-3.5 text-amber-400\" />\n                  View Client Blueprints ({submissions.length})\n                </button>\n                <button\n                  onClick={() => {\n                    setIsAdminAuthenticated(false);\n                    setShowAdminLogin(false);\n                  }}\n                  className=\"p-1.5 text-neutral-400 hover:text-neutral-600 rounded-lg hover:bg-neutral-100\"\n                  title=\"Logout Admin Mode\"\n                >\n                  <Unlock className=\"w-4 h-4 text-emerald-500\" />\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n      </header>\n\n      {/* Main Container */}\n      <main className=\"max-w-4xl mx-auto px-4 py-8 sm:px-6\">\n        \n        {/* Intro Banner */}\n        {!isSubmitted && (\n          <div id=\"intro-banner\" className=\"mb-8 p-6 sm:p-8 rounded-3xl bg-radial from-neutral-900 to-neutral-800 text-white relative overflow-hidden border border-neutral-800 shadow-sm\">\n            <div className=\"absolute top-0 right-0 opacity-10 transform translate-x-12 -translate-y-12\">\n              <Sun className=\"w-96 h-96\" />\n            </div>\n            <div className=\"relative z-10 max-w-2xl\">\n              <span className=\"bg-amber-400/10 text-amber-300 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider border border-amber-400/25\">\n                Requirements Setup\n              </span>\n              <h2 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight mt-3 text-neutral-50\">\n                Let&apos;s Design Your Dream Solar CRM\n              </h2>\n              <p className=\"mt-2 text-sm text-neutral-300 leading-relaxed\">\n                This diagnostic form helps us understand exactly how your solar operations flow. \n                Approve the database fields you keep track of, delete/skip the ones you don&apos;t use, \n                and map out your workspace blueprint in under 5 minutes.\n              </p>\n            </div>\n          </div>\n        )}\n\n        {/* Validation Errors Panel */}\n        {errors.length > 0 && (\n          <div id=\"validation-panel\" className=\"mb-8 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-2xl flex gap-3\">\n            <AlertCircle className=\"w-5 h-5 text-rose-600 shrink-0 mt-0.5\" />\n            <div>\n              <h4 className=\"text-sm font-bold text-rose-900\">Please review your answers:</h4>\n              <ul className=\"list-disc list-inside text-xs text-rose-700 mt-1 space-y-1\">\n                {errors.map((err, i) => (\n                  <li key={i}>{err}</li>\n                ))}\n              </ul>\n            </div>\n          </div>\n        )}\n\n        {/* Success / Thank You screen */}\n        {isSubmitted && lastSubmission && (\n          <div id=\"thank-you-screen\" className=\"bg-white border border-neutral-200 rounded-3xl p-6 sm:p-8 text-center shadow-xs\">\n            <div className=\"mx-auto w-14 h-14 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-500 mb-4 border border-emerald-100\">\n              <CheckCircle2 className=\"w-8 h-8\" />\n            </div>\n            <h3 className=\"text-2xl font-bold text-neutral-900\">Your CRM Spec Has Been Compiled!</h3>\n            <p className=\"mt-2 text-sm text-neutral-500 max-w-xl mx-auto\">\n              Thank you, <strong className=\"text-neutral-900\">{lastSubmission.clientName}</strong>! \n              We have generated your custom requirements packet for <strong className=\"text-neutral-900\">{lastSubmission.companyName}</strong>. \n              Below is a summary of the choices you configured.\n            </p>\n\n            <div className=\"mt-6 p-5 bg-neutral-50 rounded-2xl text-left border border-neutral-150/80 max-w-lg mx-auto space-y-3\">\n              <h4 className=\"text-xs font-bold text-neutral-400 uppercase tracking-widest\">Configuration Summary</h4>\n              <div className=\"grid grid-cols-2 gap-y-2 text-xs text-neutral-600\">\n                <span>Customer Fields Included:</span>\n                <span className=\"font-bold text-neutral-900 text-right\">\n                  {lastSubmission.sections.find(s => s.id === \'customers\')?.fields.filter(f => f.included).length} fields\n                </span>\n                <span>Project Tech Fields:</span>\n                <span className=\"font-bold text-neutral-900 text-right\">\n                  {lastSubmission.sections.find(s => s.id === \'projects\')?.fields.filter(f => f.included).length} fields\n                </span>\n                <span>Custom Pipeline Stages:</span>\n                <span className=\"font-bold text-neutral-900 text-right\">\n                  {lastSubmission.stagesStatus === \'configured\' ? `${lastSubmission.stages.length} custom milestones` : \'DK / Skip chosen\'}\n                </span>\n                <span>Subsidy Module Setup:</span>\n                <span className=\"font-bold text-neutral-900 text-right\">\n                  {lastSubmission.sections.find(s => s.id === \'subsidy_status_history\')?.enabled ? \'\342\234\205 Active\' : \'\342\235\214 Removed\'}\n                </span>\n                <span>Financing/Bank Tracking:</span>\n                <span className=\"font-bold text-neutral-900 text-right\">\n                  {lastSubmission.sections.find(s => s.id === \'bank_info\')?.enabled ? \'\342\234\205 Active\' : \'\342\235\214 Removed\'}\n                </span>\n              </div>\n            </div>\n\n            <div className=\"mt-8 flex flex-wrap justify-center gap-3\">\n              <button\n                onClick={() => handleCopySpec(getSubmissionMarkdown(lastSubmission))}\n                className=\"bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-bold px-5 py-2.5 rounded-xl flex items-center gap-1.5 transition shadow-xs\"\n              >\n                <Copy className=\"w-4 h-4\" />\n                Copy Spec Markdown\n              </button>\n              <button\n                onClick={() => handleDownloadJSON(lastSubmission)}\n                className=\"bg-white border border-neutral-200 hover:bg-neutral-50 text-neutral-700 text-xs font-semibold px-5 py-2.5 rounded-xl flex items-center gap-1.5 transition\"\n              >\n                <Download className=\"w-4 h-4 text-neutral-400\" />\n                Download Spec Blueprint (JSON)\n              </button>\n              <button\n                onClick={handleResetForm}\n                className=\"bg-neutral-100 hover:bg-neutral-200 text-neutral-700 text-xs font-semibold px-5 py-2.5 rounded-xl transition\"\n              >\n                Configure New Blueprint\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Client Questionnaire Form */}\n        {!isSubmitted && (\n          <form onSubmit={handleSubmitForm} className=\"space-y-8\">\n            \n            {/* Contact Information */}\n            <div className=\"bg-white rounded-2xl border border-neutral-200/85 p-6 shadow-2xs\">\n              <div className=\"flex items-center gap-2 mb-4\">\n                <div className=\"bg-amber-100 text-amber-800 p-1.5 rounded-lg\">\n                  <User className=\"w-4 h-4\" />\n                </div>\n                <h3 className=\"text-base font-bold text-neutral-900\">1. Who are you? (Installer Contact Info)</h3>\n              </div>\n              <p className=\"text-xs text-neutral-500 mb-5\">\n                These contact details let us link the specifications back to you when configuring the database.\n              </p>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-xs font-bold text-neutral-700 mb-1.5\">\n                    Your Full Name <span className=\"text-rose-500\">*</span>\n                  </label>\n                  <div className=\"relative\">\n                    <User className=\"absolute left-3 top-3 w-4 h-4 text-neutral-400\" />\n                    <input\n                      type=\"text\"\n                      required\n                      value={clientName}\n                      onChange={e => setClientName(e.target.value)}\n                      placeholder=\"e.g. Rajesh Sharma\"\n                      className=\"w-full pl-9 pr-3.5 py-2.5 bg-neutral-50/50 border border-neutral-200 rounded-xl text-sm focus:bg-white focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition\"\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-neutral-700 mb-1.5\">\n                    Phone Number <span className=\"text-rose-500\">*</span>\n                  </label>\n                  <div className=\"relative\">\n                    <Phone className=\"absolute left-3 top-3 w-4 h-4 text-neutral-400\" />\n                    <input\n                      type=\"tel\"\n                      required\n                      value={clientPhone}\n                      onChange={e => setClientPhone(e.target.value)}\n                      placeholder=\"e.g. +91 98765 43210\"\n                      className=\"w-full pl-9 pr-3.5 py-2.5 bg-neutral-50/50 border border-neutral-200 rounded-xl text-sm focus:bg-white focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition\"\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-neutral-700 mb-1.5\">\n                    Email Address\n                  </label>\n                  <div className=\"relative\">\n                    <Mail className=\"absolute left-3 top-3 w-4 h-4 text-neutral-400\" />\n                    <input\n                      type=\"email\"\n                      value={clientEmail}\n                      onChange={e => setClientEmail(e.target.value)}\n                      placeholder=\"e.g. rajesh@greenrootsolar.com\"\n                      className=\"w-full pl-9 pr-3.5 py-2.5 bg-neutral-50/50 border border-neutral-200 rounded-xl text-sm focus:bg-white focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition\"\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-neutral-700 mb-1.5\">\n                    Solar Installer Company Name\n                  </label>\n                  <div className=\"relative\">\n                    <Building2 className=\"absolute left-3 top-3 w-4 h-4 text-neutral-400\" />\n                    <input\n                      type=\"text\"\n                      value={companyName}\n                      onChange={e => setCompanyName(e.target.value)}\n                      placeholder=\"e.g. GreenRoot Solar Pvt Ltd\"\n                      className=\"w-full pl-9 pr-3.5 py-2.5 bg-neutral-50/50 border border-neutral-200 rounded-xl text-sm focus:bg-white focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition\"\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Customers Module Customizer */}\n            {sections.filter(s => s.id === \'customers\').map(section => (\n              <div key={section.id} className=\"bg-white rounded-2xl border border-neutral-200/85 p-6 shadow-2xs\">\n                <div className=\"flex flex-col md:flex-row justify-between items-start gap-4 mb-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <div className=\"bg-amber-100 text-amber-800 p-1.5 rounded-lg\">\n                      <User className=\"w-4 h-4\" />\n                    </div>\n                    <h3 className=\"text-base font-bold text-neutral-900\">{section.title}</h3>\n                  </div>\n                </div>\n                <p className=\"text-xs text-neutral-500 mb-6 leading-relaxed\">\n                  {section.description}\n                </p>\n\n                {/* Question: Branch */}\n                <div className=\"mb-6 p-4 bg-amber-50/50 rounded-2xl border border-amber-200/60\">\n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                    <div>\n                      <h4 className=\"text-xs font-bold text-neutral-900\">Do you have more than 1 branch office?</h4>\n                      <p className=\"text-[11px] text-neutral-500\">Select &quot;No&quot; if you want us to completely remove the branch column from your database.</p>\n                    </div>\n                    <div className=\"flex gap-2\">\n                      <button\n                        type=\"button\"\n                        onClick={() => handleBranchToggle(true)}\n                        className={`px-3 py-1.5 rounded-xl text-xs font-bold transition ${\n                          isBranchIncluded()\n                            ? \'bg-amber-500 text-white shadow-xs\'\n                            : \'bg-white border border-neutral-200 text-neutral-600 hover:bg-neutral-50\'\n                        }`}\n                      >\n                        Yes, track branches\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleBranchToggle(false)}\n                        className={`px-3 py-1.5 rounded-xl text-xs font-bold transition ${\n                          !isBranchIncluded()\n                            ? \'bg-neutral-950 text-white shadow-xs\'\n                            : \'bg-white border border-neutral-200 text-neutral-600 hover:bg-neutral-50\'\n                        }`}\n                      >\n                        No, remove this field\n                      </button>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Line-by-Line Fields */}\n                <div className=\"space-y-3.5\">\n                  {section.fields.map(field => {\n                    // Hide branch field inline if client disabled branch Office above\n                    if (field.id === \'branch\' && !isBranchIncluded()) {\n                      return null;\n                    }\n\n                    return (\n                      <div\n                        key={field.id}\n                        className={`p-4 rounded-xl border transition-all duration-200 ${\n                          field.included\n                            ? \'bg-white border-neutral-200/90 shadow-2xs\'\n                            : \'bg-neutral-50/70 border-neutral-200/50 opacity-60\'\n                        }`}\n                      >\n                        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n                          <div className=\"flex-1\">\n                            <div className=\"flex flex-wrap items-center gap-2\">\n                              <span className={`text-sm font-bold ${field.included ? \'text-neutral-900\' : \'text-neutral-400 line-through\'}`}>\n                                {field.label}\n                              </span>\n                              {field.id === \'poc\' && (\n                                <span className=\"bg-amber-50 text-amber-700 text-[10px] font-bold px-2 py-0.5 rounded-full border border-amber-200/60\">\n                                  POC (Supervisor/Contact)\n                                </span>\n                              )}\n                              {field.isCustom && (\n                                <span className=\"bg-neutral-100 text-neutral-600 text-[10px] font-bold px-2 py-0.5 rounded-full border border-neutral-200\">\n                                  Custom Field\n                                </span>\n                              )}\n                            </div>\n                            <p className=\"text-xs text-neutral-500 mt-0.5 leading-relaxed\">\n                              {field.description}\n                            </p>\n                          </div>\n\n                          <div className=\"flex items-center gap-2 self-end sm:self-center\">\n                            <button\n                              type=\"button\"\n                              onClick={() => handleToggleField(section.id, field.id, true)}\n                              className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                                field.included\n                                  ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                                  : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                              }`}\n                            >\n                              <Check className=\"w-3.5 h-3.5\" />\n                              Approve\n                            </button>\n                            <button\n                              type=\"button\"\n                              onClick={() => handleToggleField(section.id, field.id, false)}\n                              className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                                !field.included\n                                  ? \'bg-neutral-100 text-neutral-700 border-neutral-200 font-bold\'\n                                  : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                              }`}\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                              Delete\n                            </button>\n\n                            {field.isCustom && (\n                              <button\n                                type=\"button\"\n                                onClick={() => handleRemoveFieldPermanently(section.id, field.id)}\n                                className=\"p-1 text-neutral-400 hover:text-rose-600 rounded-md transition\"\n                                title=\"Remove completely\"\n                              >\n                                <X className=\"w-4 h-4\" />\n                              </button>\n                            )}\n                          </div>\n                        </div>\n\n                        {/* Optional Client notes */}\n                        {field.included && (\n                          <div className=\"mt-3 pt-3 border-t border-neutral-100\">\n                            <input\n                              type=\"text\"\n                              value={field.notes}\n                              onChange={e => handleFieldNoteChange(section.id, field.id, e.target.value)}\n                              placeholder=\"Any special remarks or validations for this field? (e.g. \'Must be unique\')\"\n                              className=\"w-full px-3 py-1.5 bg-neutral-50/50 border border-neutral-200 rounded-lg text-xs focus:bg-white outline-none transition\"\n                            />\n                          </div>\n                        )}\n                      </div>\n                    );\n                  })}\n                </div>\n\n                {/* Add Custom Field trigger */}\n                <div className=\"mt-4 pt-4 border-t border-neutral-100\">\n                  {activeCustomFieldSection === section.id ? (\n                    <div className=\"p-4 bg-neutral-50 rounded-xl border border-neutral-200 space-y-3\">\n                      <h4 className=\"text-xs font-bold text-neutral-700\">Add Custom Field to Customer Module</h4>\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                        <input\n                          type=\"text\"\n                          value={customFieldName}\n                          onChange={e => setCustomFieldName(e.target.value)}\n                          placeholder=\"Field Label (e.g. GST Number)\"\n                          className=\"px-3 py-2 border border-neutral-200 bg-white rounded-lg text-xs outline-none focus:border-amber-500\"\n                        />\n                        <input\n                          type=\"text\"\n                          value={customFieldDesc}\n                          onChange={e => setCustomFieldDesc(e.target.value)}\n                          placeholder=\"Brief Description of field\"\n                          className=\"px-3 py-2 border border-neutral-200 bg-white rounded-lg text-xs outline-none focus:border-amber-500\"\n                        />\n                      </div>\n                      <div className=\"flex justify-end gap-2 text-xs\">\n                        <button\n                          type=\"button\"\n                          onClick={() => {\n                            setActiveCustomFieldSection(null);\n                            setCustomFieldName(\'\');\n                            setCustomFieldDesc(\'\');\n                          }}\n                          className=\"px-3 py-1.5 text-neutral-600 bg-white border border-neutral-200 rounded-lg\"\n                        >\n                          Cancel\n                        </button>\n                        <button\n                          type=\"button\"\n                          onClick={() => handleAddCustomField(section.id)}\n                          className=\"px-3 py-1.5 text-white bg-amber-500 font-bold rounded-lg hover:bg-amber-600 transition\"\n                        >\n                          Add Field\n                        </button>\n                      </div>\n                    </div>\n                  ) : (\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveCustomFieldSection(section.id)}\n                      className=\"flex items-center gap-1 text-xs text-amber-600 hover:text-amber-700 font-bold bg-amber-50 hover:bg-amber-100/50 px-3 py-2 rounded-xl border border-amber-200/50 transition\"\n                    >\n                      <Plus className=\"w-4 h-4\" />\n                      Add Custom Customer Field\n                    </button>\n                  )}\n                </div>\n              </div>\n            ))}\n\n            {/* Projects Module Customizer */}\n            {sections.filter(s => s.id === \'projects\').map(section => (\n              <div key={section.id} className=\"bg-white rounded-2xl border border-neutral-200/85 p-6 shadow-2xs\">\n                <div className=\"flex items-center gap-2 mb-4\">\n                  <div className=\"bg-amber-100 text-amber-800 p-1.5 rounded-lg\">\n                    <Layers className=\"w-4 h-4\" />\n                  </div>\n                  <h3 className=\"text-base font-bold text-neutral-900\">{section.title}</h3>\n                </div>\n                <p className=\"text-xs text-neutral-500 mb-6 leading-relaxed\">\n                  {section.description}\n                </p>\n\n                {/* Line-by-Line Fields */}\n                <div className=\"space-y-3.5\">\n                  {section.fields.map(field => (\n                    <div\n                      key={field.id}\n                      className={`p-4 rounded-xl border transition-all duration-200 ${\n                        field.included\n                          ? \'bg-white border-neutral-200/90 shadow-2xs\'\n                          : \'bg-neutral-50/70 border-neutral-200/50 opacity-60\'\n                      }`}\n                    >\n                      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n                        <div className=\"flex-1\">\n                          <span className={`text-sm font-bold ${field.included ? \'text-neutral-900\' : \'text-neutral-400 line-through\'}`}>\n                            {field.label}\n                          </span>\n                          <p className=\"text-xs text-neutral-500 mt-0.5 leading-relaxed\">\n                            {field.description}\n                          </p>\n                        </div>\n\n                        <div className=\"flex items-center gap-2 self-end sm:self-center\">\n                          <button\n                            type=\"button\"\n                            onClick={() => handleToggleField(section.id, field.id, true)}\n                            className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                              field.included\n                                ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                                : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                            }`}\n                          >\n                            <Check className=\"w-3.5 h-3.5\" />\n                            Approve\n                          </button>\n                          <button\n                            type=\"button\"\n                            onClick={() => handleToggleField(section.id, field.id, false)}\n                            className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                              !field.included\n                                ? \'bg-neutral-100 text-neutral-700 border-neutral-200 font-bold\'\n                                : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                            }`}\n                          >\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                            Delete\n                          </button>\n\n                          {field.isCustom && (\n                            <button\n                              type=\"button\"\n                              onClick={() => handleRemoveFieldPermanently(section.id, field.id)}\n                              className=\"p-1 text-neutral-400 hover:text-rose-600 rounded-md transition\"\n                            >\n                              <X className=\"w-4 h-4\" />\n                            </button>\n                          )}\n                        </div>\n                      </div>\n\n                      {field.included && (\n                        <div className=\"mt-3 pt-3 border-t border-neutral-100\">\n                          <input\n                            type=\"text\"\n                            value={field.notes}\n                            onChange={e => handleFieldNoteChange(section.id, field.id, e.target.value)}\n                            placeholder=\"Add special instructions or requirements for this project parameter...\"\n                            className=\"w-full px-3 py-1.5 bg-neutral-50/50 border border-neutral-200 rounded-lg text-xs focus:bg-white outline-none transition\"\n                          />\n                        </div>\n                      )}\n                    </div>\n                  ))}\n                </div>\n\n                {/* Add Custom Field */}\n                <div className=\"mt-4 pt-4 border-t border-neutral-100\">\n                  {activeCustomFieldSection === section.id ? (\n                    <div className=\"p-4 bg-neutral-50 rounded-xl border border-neutral-200 space-y-3\">\n                      <h4 className=\"text-xs font-bold text-neutral-700\">Add Custom Field to Projects Module</h4>\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                        <input\n                          type=\"text\"\n                          value={customFieldName}\n                          onChange={e => setCustomFieldName(e.target.value)}\n                          placeholder=\"Field Label (e.g. Structure Heights)\"\n                          className=\"px-3 py-2 border border-neutral-200 bg-white rounded-lg text-xs outline-none focus:border-amber-500\"\n                        />\n                        <input\n                          type=\"text\"\n                          value={customFieldDesc}\n                          onChange={e => setCustomFieldDesc(e.target.value)}\n                          placeholder=\"Brief Description\"\n                          className=\"px-3 py-2 border border-neutral-200 bg-white rounded-lg text-xs outline-none focus:border-amber-500\"\n                        />\n                      </div>\n                      <div className=\"flex justify-end gap-2 text-xs\">\n                        <button\n                          type=\"button\"\n                          onClick={() => {\n                            setActiveCustomFieldSection(null);\n                            setCustomFieldName(\'\');\n                            setCustomFieldDesc(\'\');\n                          }}\n                          className=\"px-3 py-1.5 text-neutral-600 bg-white border border-neutral-200 rounded-lg\"\n                        >\n                          Cancel\n                        </button>\n                        <button\n                          type=\"button\"\n                          onClick={() => handleAddCustomField(section.id)}\n                          className=\"px-3 py-1.5 text-white bg-amber-500 font-bold rounded-lg hover:bg-amber-600 transition\"\n                        >\n                          Add Field\n                        </button>\n                      </div>\n                    </div>\n                  ) : (\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveCustomFieldSection(section.id)}\n                      className=\"flex items-center gap-1 text-xs text-amber-600 hover:text-amber-700 font-bold bg-amber-50 hover:bg-amber-100/50 px-3 py-2 rounded-xl border border-amber-200/50 transition\"\n                    >\n                      <Plus className=\"w-4 h-4\" />\n                      Add Custom Project Parameter\n                    </button>\n                  )}\n                </div>\n              </div>\n            ))}\n\n            {/* Project Stages Customizer */}\n            <div id=\"project-stages-section\" className=\"bg-white rounded-2xl border border-neutral-200/85 p-6 shadow-2xs\">\n              <div className=\"flex items-center gap-2 mb-4\">\n                <div className=\"bg-amber-100 text-amber-800 p-1.5 rounded-lg\">\n                  <Layers className=\"w-4 h-4\" />\n                </div>\n                <h3 className=\"text-base font-bold text-neutral-900\">Project Workflow Stages</h3>\n              </div>\n              <p className=\"text-xs text-neutral-500 mb-6 leading-relaxed\">\n                Add the physical milestones or installation stages of your project pipeline. \n                Configure <strong>3 to 15 stages</strong> in the chronological order of execution. \n                If you do not know them or wish to defer, simply toggle the skip/DK option below.\n              </p>\n\n              {/* Status Select Toggles */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6\">\n                <button\n                  type=\"button\"\n                  onClick={() => setStagesStatus(\'configured\')}\n                  className={`p-4 rounded-2xl border text-left transition ${\n                    stagesStatus === \'configured\'\n                      ? \'bg-amber-50 border-amber-300 text-neutral-900 shadow-2xs\'\n                      : \'bg-white border-neutral-200 text-neutral-500 hover:bg-neutral-50\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-2 mb-1\">\n                    <div className={`w-3.5 h-3.5 rounded-full border-2 flex items-center justify-center ${\n                      stagesStatus === \'configured\' ? \'border-amber-500 bg-amber-500\' : \'border-neutral-300\'\n                    }`}>\n                      {stagesStatus === \'configured\' && <div className=\"w-1 h-1 bg-white rounded-full\"></div>}\n                    </div>\n                    <span className=\"text-xs font-bold text-neutral-900\">Define Custom Stages</span>\n                  </div>\n                  <p className=\"text-[11px] text-neutral-500 ml-5.5\">I will write my own milestones line-by-line below.</p>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => setStagesStatus(\'dk\')}\n                  className={`p-4 rounded-2xl border text-left transition ${\n                    stagesStatus === \'dk\'\n                      ? \'bg-neutral-900 border-neutral-850 text-white shadow-2xs\'\n                      : \'bg-white border-neutral-200 text-neutral-500 hover:bg-neutral-50\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-2 mb-1\">\n                    <div className={`w-3.5 h-3.5 rounded-full border-2 flex items-center justify-center ${\n                      stagesStatus === \'dk\' ? \'border-amber-400 bg-amber-400\' : \'border-neutral-300\'\n                    }`}>\n                      {stagesStatus === \'dk\' && <div className=\"w-1 h-1 bg-neutral-900 rounded-full\"></div>}\n                    </div>\n                    <span className={`text-xs font-bold ${stagesStatus === \'dk\' ? \'text-white\' : \'text-neutral-900\'}`}>\n                      Don&apos;t Know / Skip Stages\n                    </span>\n                  </div>\n                  <p className={`text-[11px] ml-5.5 ${stagesStatus === \'dk\' ? \'text-neutral-400\' : \'text-neutral-500\'}`}>\n                    Skip this section. Let the developer configure a standard solar pipeline.\n                  </p>\n                </button>\n              </div>\n\n              {stagesStatus === \'configured\' && (\n                <div className=\"space-y-4 animate-fade-in\">\n                  {/* Enter Stage Input */}\n                  <div className=\"flex gap-2\">\n                    <input\n                      type=\"text\"\n                      value={currentStageInput}\n                      onChange={e => setCurrentStageInput(e.target.value)}\n                      onKeyDown={e => e.key === \'Enter\' && (e.preventDefault(), handleAddStage())}\n                      placeholder=\"e.g. Site Feasibility Check, Net Metering Apply, Rooftop Fitting...\"\n                      className=\"flex-1 px-4 py-2.5 bg-neutral-50 border border-neutral-200 rounded-xl text-xs outline-none focus:bg-white focus:border-amber-500\"\n                    />\n                    <button\n                      type=\"button\"\n                      onClick={handleAddStage}\n                      className=\"bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold px-4 py-2 rounded-xl flex items-center gap-1 shrink-0 transition\"\n                    >\n                      <PlusCircle className=\"w-4 h-4\" />\n                      Add Stage\n                    </button>\n                  </div>\n\n                  {/* Configured Stages list */}\n                  <div className=\"border border-neutral-150 rounded-2xl bg-neutral-50/50 p-4\">\n                    {stages.length === 0 ? (\n                      <p className=\"text-xs text-neutral-500 text-center py-4\">\n                        No stages added yet. Type a milestone name above and click <strong>Add Stage</strong>.\n                      </p>\n                    ) : (\n                      <div className=\"space-y-2\">\n                        <span className=\"text-[10px] font-bold text-neutral-400 uppercase tracking-widest block mb-2\">\n                          Pipeline Workflow Timeline ({stages.length} of max 15 stages)\n                        </span>\n                        {stages.map((stage, idx) => (\n                          <div\n                            key={idx}\n                            className=\"flex items-center justify-between gap-3 bg-white p-3 rounded-xl border border-neutral-200 shadow-3xs\"\n                          >\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"bg-neutral-100 text-neutral-600 text-xs font-bold w-5 h-5 rounded-md flex items-center justify-center\">\n                                {idx + 1}\n                              </span>\n                              <span className=\"text-xs font-bold text-neutral-800\">{stage}</span>\n                            </div>\n                            <button\n                              type=\"button\"\n                              onClick={() => handleRemoveStage(idx)}\n                              className=\"p-1 text-neutral-400 hover:text-rose-600 rounded-md transition\"\n                              title=\"Delete stage\"\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                            </button>\n                          </div>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Financials & Automatic calculations */}\n            {sections.filter(s => s.id === \'financials\').map(section => (\n              <div key={section.id} className=\"bg-white rounded-2xl border border-neutral-200/85 p-6 shadow-2xs\">\n                <div className=\"flex items-center gap-2 mb-4\">\n                  <div className=\"bg-amber-100 text-amber-800 p-1.5 rounded-lg\">\n                    <Wallet className=\"w-4 h-4\" />\n                  </div>\n                  <h3 className=\"text-base font-bold text-neutral-900\">{section.title}</h3>\n                </div>\n                <p className=\"text-xs text-neutral-500 mb-6 leading-relaxed\">\n                  Configure ledger settings. In your bespoke Solar CRM, calculations of outstanding receivables \n                  and receipts will revise <strong>fully automatically</strong>.\n                </p>\n\n                {/* Auto Revision calculations banner */}\n                <div className=\"mb-6 p-4 bg-emerald-50/50 border border-emerald-200/60 rounded-2xl flex items-start gap-3\">\n                  <CheckCircle2 className=\"w-5 h-5 text-emerald-600 shrink-0 mt-0.5\" />\n                  <div>\n                    <h4 className=\"text-xs font-bold text-emerald-900\">Dynamic Outstanding Balance Engine</h4>\n                    <p className=\"text-[11px] text-emerald-700 mt-0.5 leading-relaxed\">\n                      Your CRM will dynamically calculate outstanding balance of projects in real-time:<br />\n                      <code className=\"bg-emerald-100 px-1 py-0.5 rounded font-mono text-[10px] text-emerald-900 font-bold\">\n                        Receivable Balance = Quoted Project Cost - Discount - Total Amount Received\n                      </code>\n                    </p>\n                  </div>\n                </div>\n\n                {/* Line-by-Line Fields */}\n                <div className=\"space-y-3.5\">\n                  {section.fields.map(field => (\n                    <div\n                      key={field.id}\n                      className={`p-4 rounded-xl border transition-all duration-200 ${\n                        field.included\n                          ? \'bg-white border-neutral-200/90 shadow-2xs\'\n                          : \'bg-neutral-50/70 border-neutral-200/50 opacity-60\'\n                      }`}\n                    >\n                      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n                        <div className=\"flex-1\">\n                          <span className={`text-sm font-bold ${field.included ? \'text-neutral-900\' : \'text-neutral-400 line-through\'}`}>\n                            {field.label}\n                          </span>\n                          <p className=\"text-xs text-neutral-500 mt-0.5 leading-relaxed\">\n                            {field.description}\n                          </p>\n                        </div>\n\n                        <div className=\"flex items-center gap-2 self-end sm:self-center\">\n                          <button\n                            type=\"button\"\n                            onClick={() => handleToggleField(section.id, field.id, true)}\n                            className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                              field.included\n                                ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                                : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                            }`}\n                          >\n                            <Check className=\"w-3.5 h-3.5\" />\n                            Approve\n                          </button>\n                          <button\n                            type=\"button\"\n                            onClick={() => handleToggleField(section.id, field.id, false)}\n                            className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                              !field.included\n                                ? \'bg-neutral-100 text-neutral-700 border-neutral-200 font-bold\'\n                                : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                            }`}\n                          >\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                            Delete\n                          </button>\n\n                          {field.isCustom && (\n                            <button\n                              type=\"button\"\n                              onClick={() => handleRemoveFieldPermanently(section.id, field.id)}\n                              className=\"p-1 text-neutral-400 hover:text-rose-600 rounded-md transition\"\n                            >\n                              <X className=\"w-4 h-4\" />\n                            </button>\n                          )}\n                        </div>\n                      </div>\n\n                      {field.included && (\n                        <div className=\"mt-3 pt-3 border-t border-neutral-100\">\n                          <input\n                            type=\"text\"\n                            value={field.notes}\n                            onChange={e => handleFieldNoteChange(section.id, field.id, e.target.value)}\n                            placeholder=\"Add payment rules (e.g. \'Support Google Pay/UPI\', \'Online Transfer ONLY\')...\"\n                            className=\"w-full px-3 py-1.5 bg-neutral-50/50 border border-neutral-200 rounded-lg text-xs focus:bg-white outline-none transition\"\n                          />\n                        </div>\n                      )}\n                    </div>\n                  ))}\n                </div>\n\n                {/* Add Custom Financial Metric */}\n                <div className=\"mt-4 pt-4 border-t border-neutral-100\">\n                  {activeCustomFieldSection === section.id ? (\n                    <div className=\"p-4 bg-neutral-50 rounded-xl border border-neutral-200 space-y-3\">\n                      <h4 className=\"text-xs font-bold text-neutral-700\">Add Custom Financial Parameter</h4>\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                        <input\n                          type=\"text\"\n                          value={customFieldName}\n                          onChange={e => setCustomFieldName(e.target.value)}\n                          placeholder=\"Label (e.g. Subsidy Deducted Rate)\"\n                          className=\"px-3 py-2 border border-neutral-200 bg-white rounded-lg text-xs outline-none focus:border-amber-500\"\n                        />\n                        <input\n                          type=\"text\"\n                          value={customFieldDesc}\n                          onChange={e => setCustomFieldDesc(e.target.value)}\n                          placeholder=\"Brief Description\"\n                          className=\"px-3 py-2 border border-neutral-200 bg-white rounded-lg text-xs outline-none focus:border-amber-500\"\n                        />\n                      </div>\n                      <div className=\"flex justify-end gap-2 text-xs\">\n                        <button\n                          type=\"button\"\n                          onClick={() => {\n                            setActiveCustomFieldSection(null);\n                            setCustomFieldName(\'\');\n                            setCustomFieldDesc(\'\');\n                          }}\n                          className=\"px-3 py-1.5 text-neutral-600 bg-white border border-neutral-200 rounded-lg\"\n                        >\n                          Cancel\n                        </button>\n                        <button\n                          type=\"button\"\n                          onClick={() => handleAddCustomField(section.id)}\n                          className=\"px-3 py-1.5 text-white bg-amber-500 font-bold rounded-lg hover:bg-amber-600 transition\"\n                        >\n                          Add Parameter\n                        </button>\n                      </div>\n                    </div>\n                  ) : (\n                    <button\n                      type=\"button\"\n                      onClick={() => setActiveCustomFieldSection(section.id)}\n                      className=\"flex items-center gap-1 text-xs text-amber-600 hover:text-amber-700 font-bold bg-amber-50 hover:bg-amber-100/50 px-3 py-2 rounded-xl border border-amber-200/50 transition\"\n                    >\n                      <Plus className=\"w-4 h-4\" />\n                      Add Custom Financial Tag\n                    </button>\n                  )}\n                </div>\n              </div>\n            ))}\n\n            {/* Optional Module 1: Government Subsidy Tracker */}\n            {sections.filter(s => s.id === \'subsidy_status_history\').map(section => (\n              <div key={section.id} className=\"bg-white rounded-2xl border border-neutral-200/85 p-6 shadow-2xs\">\n                <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <div className=\"bg-amber-100 text-amber-800 p-1.5 rounded-lg\">\n                      <TrendingUp className=\"w-4 h-4\" />\n                    </div>\n                    <h3 className=\"text-base font-bold text-neutral-900\">{section.title}</h3>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-xs text-neutral-500\">Track Subsidies?</span>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleToggleSection(section.id, true)}\n                      className={`px-3 py-1 text-xs font-bold rounded-lg border transition ${\n                        section.enabled\n                          ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                          : \'bg-white text-neutral-400 border-neutral-200 hover:bg-neutral-50\'\n                      }`}\n                    >\n                      Yes, Keep Module\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleToggleSection(section.id, false)}\n                      className={`px-3 py-1 text-xs font-bold rounded-lg border transition ${\n                        !section.enabled\n                          ? \'bg-neutral-900 text-white border-neutral-800\'\n                          : \'bg-white text-neutral-400 border-neutral-200 hover:bg-neutral-50\'\n                      }`}\n                    >\n                      No, Delete Module\n                    </button>\n                  </div>\n                </div>\n\n                {section.enabled ? (\n                  <div className=\"space-y-3.5 animate-fade-in\">\n                    <p className=\"text-xs text-neutral-500 mb-4 leading-relaxed\">\n                      {section.description}\n                    </p>\n\n                    {section.fields.map(field => (\n                      <div\n                        key={field.id}\n                        className={`p-4 rounded-xl border transition-all duration-200 ${\n                          field.included\n                            ? \'bg-white border-neutral-200/90 shadow-2xs\'\n                            : \'bg-neutral-50/70 border-neutral-200/50 opacity-60\'\n                        }`}\n                      >\n                        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n                          <div className=\"flex-1\">\n                            <span className={`text-sm font-bold ${field.included ? \'text-neutral-900\' : \'text-neutral-400 line-through\'}`}>\n                              {field.label}\n                            </span>\n                            <p className=\"text-xs text-neutral-500 mt-0.5 leading-relaxed\">\n                              {field.description}\n                            </p>\n                          </div>\n\n                          <div className=\"flex items-center gap-2 self-end sm:self-center\">\n                            <button\n                              type=\"button\"\n                              onClick={() => handleToggleField(section.id, field.id, true)}\n                              className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                                field.included\n                                  ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                                  : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                              }`}\n                            >\n                              <Check className=\"w-3.5 h-3.5\" />\n                              Approve\n                            </button>\n                            <button\n                              type=\"button\"\n                              onClick={() => handleToggleField(section.id, field.id, false)}\n                              className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                                !field.included\n                                  ? \'bg-neutral-100 text-neutral-700 border-neutral-200 font-bold\'\n                                  : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                              }`}\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                              Delete\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                ) : (\n                  <p className=\"text-xs text-neutral-400 bg-neutral-50 p-4 rounded-xl text-center\">\n                    Subsidy tracker disabled. We will remove this entire history tracker from your system setup database.\n                  </p>\n                )}\n              </div>\n            ))}\n\n            {/* Optional Module 2: Banking & Loan Details */}\n            {sections.filter(s => s.id === \'bank_info\').map(section => (\n              <div key={section.id} className=\"bg-white rounded-2xl border border-neutral-200/85 p-6 shadow-2xs\">\n                <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4\">\n                  <div className=\"flex items-center gap-2\">\n                    <div className=\"bg-amber-100 text-amber-800 p-1.5 rounded-lg\">\n                      <Building2 className=\"w-4 h-4\" />\n                    </div>\n                    <h3 className=\"text-base font-bold text-neutral-900\">{section.title}</h3>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-xs text-neutral-500\">Track Bank Info?</span>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleToggleSection(section.id, true)}\n                      className={`px-3 py-1 text-xs font-bold rounded-lg border transition ${\n                        section.enabled\n                          ? \'bg-emerald-50 text-emerald-700 border-emerald-200\'\n                          : \'bg-white text-neutral-400 border-neutral-200 hover:bg-neutral-50\'\n                      }`}\n                    >\n                      Yes, Keep Module\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleToggleSection(section.id, false)}\n                      className={`px-3 py-1 text-xs font-bold rounded-lg border transition ${\n                        !section.enabled\n                          ? \'bg-neutral-900 text-white border-neutral-800\'\n                          : \'bg-white text-neutral-400 border-neutral-200 hover:bg-neutral-50\'\n                      }`}\n                    >\n                      No, Delete Module\n                    </button>\n                  </div>\n                </div>\n\n                {section.enabled ? (\n                  <div className=\"space-y-3.5 animate-fade-in\">\n                    <p className=\"text-xs text-neutral-500 mb-4 leading-relaxed\">\n                      {section.description}\n                    </p>\n\n                    {section.fields.map(field => (\n                      <div\n                        key={field.id}\n                        className={`p-4 rounded-xl border transition-all duration-200 ${\n                          field.included\n                            ? \'bg-white border-neutral-200/90 shadow-2xs\'\n                            : \'bg-neutral-50/70 border-neutral-200/50 opacity-60\'\n                        }`}\n                      >\n                        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3\">\n                          <div className=\"flex-1\">\n                            <div className=\"flex items-center gap-2\">\n                              <span className={`text-sm font-bold ${field.included ? \'text-neutral-900\' : \'text-neutral-400 line-through\'}`}>\n                                {field.label}\n                              </span>\n                              {field.id === \'loan_app_number\' && (\n                                <span className=\"bg-amber-50 text-amber-700 text-[10px] font-bold px-2 py-0.5 rounded-full border border-amber-200/60\">\n                                  Skip/Delete if not needed\n                                </span>\n                              )}\n                            </div>\n                            <p className=\"text-xs text-neutral-500 mt-0.5 leading-relaxed\">\n                              {field.description}\n                            </p>\n                          </div>\n\n                          <div className=\"flex items-center gap-2 self-end sm:self-center\">\n                            <button\n                              type=\"button\"\n                              onClick={() => handleToggleField(section.id, field.id, true)}\n                              className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                                field.included\n                                  ? \'bg-amber-50 text-amber-700 border-amber-200\'\n                                  : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                              }`}\n                            >\n                              <Check className=\"w-3.5 h-3.5\" />\n                              Approve\n                            </button>\n                            <button\n                              type=\"button\"\n                              onClick={() => handleToggleField(section.id, field.id, false)}\n                              className={`px-3 py-1.5 text-xs font-bold rounded-lg border transition flex items-center gap-1 ${\n                                !field.included\n                                  ? \'bg-neutral-100 text-neutral-700 border-neutral-200 font-bold\'\n                                  : \'bg-white text-neutral-500 border-neutral-200 hover:bg-neutral-50\'\n                              }`}\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                              Delete\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                ) : (\n                  <p className=\"text-xs text-neutral-400 bg-neutral-50 p-4 rounded-xl text-center\">\n                    Banking details collection and Solar Bank Loan coordination forms removed.\n                  </p>\n                )}\n              </div>\n            ))}\n\n            {/* Custom Notes Section */}\n            <div className=\"bg-white rounded-2xl border border-neutral-200/85 p-6 shadow-2xs\">\n              <label className=\"block text-sm font-bold text-neutral-900 mb-2\">\n                \360\237\222\254 Additional CRM Requirements or Notes\n              </label>\n              <textarea\n                rows={4}\n                value={customNotes}\n                onChange={e => setCustomNotes(e.target.value)}\n                placeholder=\"List any extra requirements, custom automation requests, integrations, or specific dashboard charts you\'d love to have in your CRM...\"\n                className=\"w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-2xl text-xs outline-none focus:bg-white focus:border-amber-500 transition\"\n              />\n            </div>\n\n            {/* Submission Button */}\n            <div className=\"flex justify-center pt-4\">\n              <button\n                type=\"submit\"\n                className=\"w-full sm:w-auto px-10 py-4 bg-amber-500 hover:bg-amber-600 active:scale-98 text-white font-extrabold text-sm rounded-2xl transition duration-150 shadow-md flex items-center justify-center gap-2 tracking-wide\"\n              >\n                Compile Bespoke CRM Spec\n                <ArrowRight className=\"w-4 h-4 stroke-[2.5]\" />\n              </button>\n            </div>\n\n          </form>\n        )}\n\n      </main>\n\n      {/* Modern Locked Modal for Admin access */}\n      {showAdminLogin && (\n        <div id=\"admin-modal\" className=\"fixed inset-0 z-50 bg-neutral-900/60 backdrop-blur-xs flex items-center justify-center p-4\">\n          <div className=\"bg-white rounded-3xl w-full max-w-md border border-neutral-200 shadow-xl overflow-hidden relative animate-fade-in\">\n            \n            <button\n              onClick={() => {\n                setShowAdminLogin(false);\n                setLoginError(\'\');\n              }}\n              className=\"absolute top-4 right-4 text-neutral-400 hover:text-neutral-600 p-1.5 hover:bg-neutral-50 rounded-lg transition\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n\n            <div className=\"p-6\">\n              <div className=\"flex flex-col items-center text-center mt-3 mb-6\">\n                <div className=\"bg-amber-100 text-amber-700 p-3 rounded-full mb-3 border border-amber-200\">\n                  <KeyRound className=\"w-6 h-6\" />\n                </div>\n                <h3 className=\"text-lg font-bold text-neutral-900\">\n                  {isPasswordSetupMode ? \'Create Developer Passcode\' : \'Developer Admin Dashboard Access\'}\n                </h3>\n                <p className=\"text-xs text-neutral-500 mt-1 max-w-xs leading-relaxed\">\n                  {isPasswordSetupMode \n                    ? \'Setup a private passcode to secure your prospective clients\342\200\231 CRM specifications.\'\n                    : \'Enter the passcode to unlock and view compiled specifications sent by your prospective customers.\'\n                  }\n                </p>\n              </div>\n\n              <form onSubmit={handleAdminAuth} className=\"space-y-4\">\n                <div>\n                  <label className=\"block text-[10px] font-bold text-neutral-400 uppercase tracking-widest mb-1.5\">\n                    {isPasswordSetupMode ? \'Choose Password\' : \'Admin Password\'}\n                  </label>\n                  <input\n                    type=\"password\"\n                    required\n                    value={adminPasswordInput}\n                    onChange={e => setAdminPasswordInput(e.target.value)}\n                    placeholder={isPasswordSetupMode ? \'e.g. secret123\' : \'\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\'}\n                    className=\"w-full px-3.5 py-2.5 bg-neutral-50 border border-neutral-200 rounded-xl text-sm focus:bg-white outline-none focus:border-amber-500 transition\"\n                  />\n                </div>\n\n                {isPasswordSetupMode && (\n                  <div>\n                    <label className=\"block text-[10px] font-bold text-neutral-400 uppercase tracking-widest mb-1.5\">\n                      Confirm Password\n                    </label>\n                    <input\n                      type=\"password\"\n                      required\n                      value={newPasswordConfirm}\n                      onChange={e => setNewPasswordConfirm(e.target.value)}\n                      placeholder=\"Confirm passcode\"\n                      className=\"w-full px-3.5 py-2.5 bg-neutral-50 border border-neutral-200 rounded-xl text-sm focus:bg-white outline-none focus:border-amber-500 transition\"\n                    />\n                  </div>\n                )}\n\n                {loginError && (\n                  <div className=\"p-2.5 bg-rose-50 text-rose-700 text-xs rounded-lg border border-rose-100 flex items-center gap-2\">\n                    <AlertCircle className=\"w-3.5 h-3.5 text-rose-600 shrink-0\" />\n                    <span>{loginError}</span>\n                  </div>\n                )}\n\n                {!isPasswordSetupMode && (\n                  <div className=\"text-[11px] text-neutral-400 text-center\">\n                    Default developer passcode bypass is: <strong className=\"text-neutral-500\">admin123</strong>\n                  </div>\n                )}\n\n                <button\n                  type=\"submit\"\n                  className=\"w-full py-3 bg-neutral-900 hover:bg-neutral-800 text-white font-bold text-xs rounded-xl shadow-xs transition\"\n                >\n                  {isPasswordSetupMode ? \'Confirm Password Setup\' : \'Unlock Dashboard\'}\n                </button>\n              </form>\n\n              {/* Submissions Viewer inside the same unlocked interface */}\n              {isAdminAuthenticated && (\n                <div className=\"mt-6 pt-6 border-t border-neutral-100 max-h-96 overflow-y-auto\">\n                  <div className=\"flex justify-between items-center mb-4\">\n                    <h4 className=\"text-xs font-bold text-neutral-400 uppercase tracking-widest\">Client Specs Database</h4>\n                    <span className=\"bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full\">\n                      {submissions.length} Total\n                    </span>\n                  </div>\n\n                  {submissions.length === 0 ? (\n                    <p className=\"text-xs text-neutral-400 text-center py-4\">No submissions received yet.</p>\n                  ) : (\n                    <div className=\"space-y-2\">\n                      {submissions.map(sub => (\n                        <button\n                          key={sub.id}\n                          onClick={() => {\n                            setSelectedSubmissionId(sub.id);\n                            // Modal can close or stay open\n                          }}\n                          className={`w-full text-left p-3 rounded-xl border transition flex items-center justify-between gap-3 ${\n                            selectedSubmissionId === sub.id\n                              ? \'bg-amber-50 border-amber-300\'\n                              : \'bg-white border-neutral-200 hover:bg-neutral-50\'\n                          }`}\n                        >\n                          <div>\n                            <div className=\"font-bold text-xs text-neutral-900\">{sub.companyName}</div>\n                            <div className=\"text-[10px] text-neutral-500 mt-0.5\">{sub.clientName} \342\200\242 {sub.clientPhone}</div>\n                          </div>\n                          <span className=\"text-[9px] text-neutral-400 shrink-0\">{sub.submittedAt.split(\',\')[0]}</span>\n                        </button>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              )}\n\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Admin Submissions Detail Panel (Shown beneath if logged in) */}\n      {isAdminAuthenticated && (\n        <div id=\"admin-spec-explorer\" className=\"bg-neutral-900 text-neutral-100 py-12 px-4 sm:px-6 border-t border-neutral-800\">\n          <div className=\"max-w-4xl mx-auto space-y-8\">\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-neutral-800 pb-6\">\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"bg-amber-400 text-neutral-950 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider\">\n                    Developer Dashboard\n                  </span>\n                  <span className=\"text-xs text-neutral-400\">Authenticated Session</span>\n                </div>\n                <h2 className=\"text-xl sm:text-2xl font-bold tracking-tight text-white mt-1\">\n                  Solar Installer Requirements Explorer\n                </h2>\n              </div>\n              <button\n                onClick={() => {\n                  setIsAdminAuthenticated(false);\n                  window.scrollTo({ top: 0, behavior: \'smooth\' });\n                }}\n                className=\"self-start sm:self-center px-4 py-2 border border-neutral-800 hover:bg-neutral-800 text-neutral-300 text-xs font-semibold rounded-xl transition\"\n              >\n                Exit Admin Mode\n              </button>\n            </div>\n\n            {submissions.length === 0 ? (\n              <div className=\"text-center py-12 border border-dashed border-neutral-800 rounded-3xl\">\n                <Database className=\"w-12 h-12 text-neutral-700 mx-auto mb-3\" />\n                <h3 className=\"text-sm font-bold text-neutral-300\">No specs received on this device yet</h3>\n                <p className=\"text-xs text-neutral-500 mt-1 max-w-xs mx-auto\">\n                  When a client fills out the configuration form and hits compile, their bespoke layout will appear here.\n                </p>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-start\">\n                \n                {/* Left Side: Submission List (4 cols) */}\n                <div className=\"md:col-span-4 bg-neutral-950 rounded-2xl border border-neutral-800 p-4 space-y-2 max-h-[500px] overflow-y-auto\">\n                  <span className=\"text-[10px] font-black text-neutral-500 uppercase tracking-widest block mb-2 px-2\">\n                    Client Submissions List\n                  </span>\n                  {submissions.map(sub => (\n                    <div\n                      key={sub.id}\n                      onClick={() => setSelectedSubmissionId(sub.id)}\n                      className={`group p-3 rounded-xl border cursor-pointer transition flex items-center justify-between gap-2 ${\n                        selectedSubmissionId === sub.id\n                          ? \'bg-neutral-900 border-amber-500\'\n                          : \'bg-neutral-950 border-neutral-850 hover:bg-neutral-900\'\n                      }`}\n                    >\n                      <div className=\"min-w-0 flex-1\">\n                        <div className=\"font-bold text-xs text-neutral-200 group-hover:text-white truncate\">{sub.companyName}</div>\n                        <div className=\"text-[10px] text-neutral-500 truncate mt-0.5\">{sub.clientName}</div>\n                        <div className=\"text-[9px] text-amber-500 mt-1\">{sub.submittedAt}</div>\n                      </div>\n                      <button\n                        onClick={(e) => {\n                          e.stopPropagation();\n                          handleDeleteSubmission(sub.id);\n                        }}\n                        className=\"p-1 text-neutral-600 hover:text-rose-400 rounded-md transition hover:bg-rose-950/40\"\n                        title=\"Delete record\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  ))}\n                </div>\n\n                {/* Right Side: Selected Submission Blueprint View (8 cols) */}\n                <div className=\"md:col-span-8 bg-neutral-950 border border-neutral-800 rounded-2xl p-6 space-y-6\">\n                  {activeAdminSub ? (\n                    <div className=\"space-y-6 animate-fade-in\">\n                      \n                      {/* Top Summary Banner */}\n                      <div className=\"flex flex-col sm:flex-row justify-between items-start gap-4 border-b border-neutral-800 pb-5\">\n                        <div>\n                          <h3 className=\"text-lg font-bold text-white\">{activeAdminSub.companyName}</h3>\n                          <p className=\"text-xs text-neutral-400 mt-1\">\n                            Contact: <span className=\"text-neutral-200\">{activeAdminSub.clientName}</span> ({activeAdminSub.clientPhone}) \n                            {activeAdminSub.clientEmail && ` \342\200\242 ${activeAdminSub.clientEmail}`}\n                          </p>\n                          <p className=\"text-[10px] text-neutral-500 mt-0.5\">Submitted at: {activeAdminSub.submittedAt}</p>\n                        </div>\n\n                        <div className=\"flex items-center gap-2 self-start\">\n                          <button\n                            onClick={() => handleCopySpec(getSubmissionMarkdown(activeAdminSub))}\n                            className=\"p-2 bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 hover:border-neutral-700 text-white text-xs font-semibold rounded-xl flex items-center gap-1.5 transition\"\n                            title=\"Copy Markdown schema specifications\"\n                          >\n                            <Copy className=\"w-3.5 h-3.5\" />\n                            <span>Copy Specs</span>\n                          </button>\n                          <button\n                            onClick={() => handleDownloadJSON(activeAdminSub)}\n                            className=\"p-2 bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 hover:border-neutral-700 text-white text-xs font-semibold rounded-xl flex items-center gap-1.5 transition\"\n                            title=\"Download standard JSON definition file\"\n                          >\n                            <Download className=\"w-3.5 h-3.5 text-neutral-400\" />\n                          </button>\n                        </div>\n                      </div>\n\n                      {/* Line-by-Line Spec review */}\n                      <div className=\"space-y-5 max-h-[600px] overflow-y-auto pr-1\">\n                        \n                        {/* Modules */}\n                        {activeAdminSub.sections.map(sec => {\n                          const activeFields = sec.fields.filter(f => f.included);\n                          const deletedFields = sec.fields.filter(f => !f.included);\n\n                          if (sec.id === \'subsidy_status_history\' && !sec.enabled) {\n                            return (\n                              <div key={sec.id} className=\"border-b border-neutral-900 pb-4\">\n                                <h4 className=\"text-xs font-black text-amber-500 uppercase tracking-wider mb-1\">{sec.title}</h4>\n                                <p className=\"text-xs text-neutral-500\">\342\235\214 Client requested to exclude this entire module.</p>\n                              </div>\n                            );\n                          }\n\n                          if (sec.id === \'bank_info\' && !sec.enabled) {\n                            return (\n                              <div key={sec.id} className=\"border-b border-neutral-900 pb-4\">\n                                <h4 className=\"text-xs font-black text-amber-500 uppercase tracking-wider mb-1\">{sec.title}</h4>\n                                <p className=\"text-xs text-neutral-500\">\342\235\214 Client requested to exclude this entire module.</p>\n                              </div>\n                            );\n                          }\n\n                          return (\n                            <div key={sec.id} className=\"border-b border-neutral-900 pb-4 space-y-2\">\n                              <h4 className=\"text-xs font-black text-amber-500 uppercase tracking-wider\">{sec.title}</h4>\n                              \n                              <div className=\"space-y-1.5\">\n                                {activeFields.map(f => (\n                                  <div key={f.id} className=\"bg-neutral-900 p-2.5 rounded-lg border border-neutral-850 text-xs\">\n                                    <div className=\"flex justify-between items-center gap-2\">\n                                      <span className=\"font-bold text-neutral-200\">{f.label} <code className=\"text-[10px] text-amber-400/80 font-mono\">({f.id})</code></span>\n                                      <span className=\"text-[9px] bg-emerald-950 text-emerald-400 border border-emerald-900 px-1.5 py-0.5 rounded-md font-bold uppercase\">Approved</span>\n                                    </div>\n                                    <p className=\"text-[11px] text-neutral-500 mt-0.5\">{f.description}</p>\n                                    {f.notes && (\n                                      <div className=\"mt-2 text-[10px] bg-neutral-950 text-neutral-400 p-1.5 rounded-md border border-neutral-900\">\n                                        \360\237\222\241 {f.notes}\n                                      </div>\n                                    )}\n                                  </div>\n                                ))}\n\n                                {deletedFields.map(f => (\n                                  <div key={f.id} className=\"bg-neutral-900/40 p-2 rounded-lg border border-neutral-900 opacity-50 flex items-center justify-between text-xs text-neutral-500\">\n                                    <span>~~{f.label}~~ ({f.id})</span>\n                                    <span className=\"text-[9px] text-rose-500 font-bold uppercase\">Deleted</span>\n                                  </div>\n                                ))}\n                              </div>\n                            </div>\n                          );\n                        })}\n\n                        {/* Stages */}\n                        <div className=\"border-b border-neutral-900 pb-4 space-y-2\">\n                          <h4 className=\"text-xs font-black text-amber-500 uppercase tracking-wider\">Custom Project Workflow Timeline</h4>\n                          {activeAdminSub.stagesStatus === \'dk\' ? (\n                            <p className=\"text-xs text-neutral-500 bg-neutral-900 p-3 rounded-lg border border-neutral-850 italic\">\n                              Client checked: &quot;I don&apos;t know / Skip custom stages (Developer will decide)&quot;\n                            </p>\n                          ) : activeAdminSub.stages.length === 0 ? (\n                            <p className=\"text-xs text-neutral-500 bg-neutral-900 p-3 rounded-lg border border-neutral-850\">\n                              No custom stages provided.\n                            </p>\n                          ) : (\n                            <div className=\"space-y-1.5\">\n                              {activeAdminSub.stages.map((stg, i) => (\n                                <div key={i} className=\"bg-neutral-900 p-2.5 rounded-lg border border-neutral-850 flex items-center gap-2 text-xs\">\n                                  <span className=\"bg-neutral-950 text-neutral-400 font-bold px-1.5 py-0.5 rounded font-mono\">{i + 1}</span>\n                                  <span className=\"font-bold text-neutral-200\">{stg}</span>\n                                </div>\n                              ))}\n                            </div>\n                          )}\n                        </div>\n\n                        {/* Extra Notes */}\n                        {activeAdminSub.customNotes && (\n                          <div className=\"space-y-1.5\">\n                            <h4 className=\"text-xs font-black text-amber-500 uppercase tracking-wider\">Client Remarks / Comments</h4>\n                            <div className=\"bg-neutral-900 p-3 rounded-xl border border-neutral-850 text-xs text-neutral-300 whitespace-pre-wrap\">\n                              {activeAdminSub.customNotes}\n                            </div>\n                          </div>\n                        )}\n\n                      </div>\n\n                    </div>\n                  ) : (\n                    <p className=\"text-xs text-neutral-500 text-center py-12\">Select a client spec file on the left to inspect database layout specifications.</p>\n                  )}\n                </div>\n\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Developer Footer Brand */}\n      <footer id=\"app-footer\" className=\"mt-16 bg-white border-t border-neutral-200/80 py-8 px-4 text-center text-xs text-neutral-400\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-2\">\n            <Sun className=\"w-4 h-4 text-amber-500\" />\n            <span className=\"font-bold text-neutral-700\">Solar CRM Specification Portal</span>\n          </div>\n          <p>\302\251 2026 Solar Operations Consulting. Built for client requirements gathering.</p>\n          <div className=\"flex gap-4\">\n            <button\n              onClick={() => {\n                setLoginError(\'\');\n                setAdminPasswordInput(\'\');\n                setShowAdminLogin(true);\n              }}\n              className=\"hover:text-neutral-600 transition font-medium\"\n            >\n              Developer Admin Portal\n            </button>\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
    }
