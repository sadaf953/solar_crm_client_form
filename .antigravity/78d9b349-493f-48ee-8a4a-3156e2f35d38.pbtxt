      replacement_content: "import tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\nimport { generateProposal } from \'./src/api-handler\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [\n      react(), \n      tailwindcss(),\n      {\n        name: \'api-server\',\n        configureServer(server) {\n          server.middlewares.use(async (req, res, next) => {\n            if (req.url?.startsWith(\'/api/generate-proposal\') && req.method === \'POST\') {\n              let body = \'\';\n              req.on(\'data\', chunk => {\n                body += chunk.toString();\n              });\n              req.on(\'end\', async () => {\n                try {\n                  const payload = JSON.parse(body);\n                  const result = await generateProposal(payload);\n                  res.writeHead(200, { \'Content-Type\': \'application/json\' });\n                  res.end(JSON.stringify({ proposal: result }));\n                } catch (error: any) {\n                  res.writeHead(500, { \'Content-Type\': \'application/json\' });\n                  res.end(JSON.stringify({ error: error.message || \'Internal server error\' }));\n                }\n              });\n            } else {\n              next();\n            }\n          });\n        }\n      }\n    ],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n"
    }
    instruction: "Add api-server middleware to handle /api/generate-proposal requests using the custom api-handler."
