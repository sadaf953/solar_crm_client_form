    instruction: "Insert the renderFieldRow helper inside App.tsx"
    replacement_infos {
      original_chunk {
        target_content: "  // Dropdown options update\n  const handleDropdownOptionsChange = (sectionId: string, fieldId: string, dropdownOptions: string) => {\n    setSections(prev =>\n      prev.map(sec => {\n        if (sec.id === sectionId) {\n          return {\n            ...sec,\n            fields: sec.fields.map(f => {\n              if (f.id === fieldId) {\n                return { ...f, dropdownOptions };\n              }\n              return f;\n            })\n          };\n        }\n        return sec;\n      })\n    );\n  };"
        replacement_content: "  // Dropdown options update\n  const handleDropdownOptionsChange = (sectionId: string, fieldId: string, dropdownOptions: string) => {\n    setSections(prev =>\n      prev.map(sec => {\n        if (sec.id === sectionId) {\n          return {\n            ...sec,\n            fields: sec.fields.map(f => {\n              if (f.id === fieldId) {\n                return { ...f, dropdownOptions };\n              }\n              return f;\n            })\n          };\n        }\n        return sec;\n      })\n    );\n  };\n\n  const renderFieldRow = (sectionId: string, field: FieldConfig) => {\n    const isIncluded = field.included;\n    const fType = field.fieldType || \'text\';\n    \n    return (\n      <div\n        key={field.id}\n        className={`p-4 rounded-2xl border transition-all ${\n          isIncluded\n            ? \'bg-white border-slate-200 shadow-xs\'\n            : \'bg-slate-50/70 border-slate-200/60 opacity-60\'\n        }`}\n      >\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div className=\"flex-1\">\n            <div className=\"flex items-center gap-2\">\n              <span className={`text-sm font-bold ${isIncluded ? \'text-slate-900\' : \'text-slate-400 line-through\'}`}>\n                {field.label}\n              </span>\n              {field.isCustom && (\n                <span className=\"bg-indigo-50 text-indigo-700 border border-indigo-100 text-[9px] font-bold px-1.5 py-0.5 rounded-full uppercase\">\n                  Custom\n                </span>\n              )}\n              {field.id === \'branch\' && (\n                <span className=\"bg-amber-100 text-amber-800 border border-amber-200 text-[9px] font-bold px-1.5 py-0.5 rounded-full uppercase\">\n                  Branch Specific\n                </span>\n              )}\n            </div>\n            <p className=\"text-xs text-slate-505 mt-1 leading-relaxed\">\n              {field.id === \'poc\' ? (\n                <span>{field.description} <strong className=\"text-slate-800 font-bold block sm:inline\">If you don\'t have a POC, delete it!</strong></span>\n              ) : field.description}\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <button\n              type=\"button\"\n              onClick={() => handleToggleField(sectionId, field.id, true)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 transition ${\n                isIncluded\n                  ? \'bg-emerald-50 text-emerald-700 border border-emerald-200\'\n                  : \'bg-white text-slate-500 border border-slate-200 hover:bg-slate-50\'\n              }`}\n            >\n              <Check className=\"w-3.5 h-3.5\" />\n              Keep\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => handleToggleField(sectionId, field.id, false)}\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 transition ${\n                !isIncluded\n                  ? \'bg-rose-50 text-rose-700 border border-rose-200\'\n                  : \'bg-white text-slate-500 border border-slate-200 hover:bg-slate-50\'\n              }`}\n            >\n              <Trash2 className=\"w-3.5 h-3.5\" />\n              Remove\n            </button>\n\n            {field.isCustom && (\n              <button\n                type=\"button\"\n                onClick={() => handleDeleteCustomField(sectionId, field.id)}\n                className=\"text-slate-400 hover:text-red-600 p-1 rounded hover:bg-red-50 transition\"\n                title=\"Delete Permanently\"\n              >\n                <XCircle className=\"w-4 h-4\" />\n              </button>\n            )}\n          </div>\n        </div>\n\n        {isIncluded && (\n          <div className=\"mt-4 pt-4 border-t border-slate-100 space-y-3\">\n            {/* Field Type Selection Grid */}\n            <div className=\"space-y-1.5\">\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider\">\n                Select Field Input Type\n              </label>\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-1.5 bg-slate-50 p-1 rounded-xl border border-slate-200\">\n                {([\'text\', \'dropdown\', \'number\', \'date\'] as const).map((type) => {\n                  const labelMap = {\n                    text: \'\360\237\223\235 Text Input\',\n                    dropdown: \'\360\237\216\257 Dropdown list\',\n                    number: \'\360\237\224\242 Number Input\',\n                    date: \'\360\237\223\205 Date Picker\'\n                  };\n                  return (\n                    <button\n                      key={type}\n                      type=\"button\"\n                      onClick={() => handleFieldTypeChange(sectionId, field.id, type)}\n                      className={`py-1.5 px-2 rounded-lg text-xs font-bold text-center transition ${\n                        fType === type\n                          ? \'bg-indigo-600 text-white shadow-2xs\'\n                          : \'text-slate-600 hover:bg-slate-100\'\n                      }`}\n                    >\n                      {labelMap[type]}\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* If Dropdown is selected, show dropdown options config */}\n            {fType === \'dropdown\' ? (\n              <div className=\"space-y-1.5 animate-fade-in\">\n                <label className=\"block text-[10px] font-bold text-slate-600 uppercase tracking-wider\">\n                  List Dropdown Option Values (Comma Separated) <span className=\"text-red-500\">*</span>\n                </label>\n                <input\n                  type=\"text\"\n                  required={fType === \'dropdown\'}\n                  value={field.dropdownOptions || \'\'}\n                  onChange={(e) => handleDropdownOptionsChange(sectionId, field.id, e.target.value)}\n                  placeholder=\"e.g. Option A, Option B, Option C\"\n                  className=\"w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:border-amber-500 outline-none transition font-semibold text-slate-900\"\n                />\n                <p className=\"text-[10px] text-slate-400 font-medium\">\n                  \360\237\222\241 Provide options separated by commas (e.g. On-grid, Off-grid, Hybrid).\n                </p>\n              </div>\n            ) : (\n              <div className=\"space-y-1 animate-fade-in\">\n                <label className=\"block text-[10px] font-bold text-slate-500 uppercase tracking-wider\">\n                  Extra operational instructions (Optional)\n                </label>\n                <input\n                  type=\"text\"\n                  value={field.notes || \'\'}\n                  onChange={(e) => handleFieldNoteChange(sectionId, field.id, e.target.value)}\n                  placeholder=\"e.g. Default value, validation limits, or placeholder instructions...\"\n                  className=\"w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:border-amber-500 outline-none transition font-medium text-slate-900\"\n                />\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n    );\n  };"
      }
      num_matches: 1
    }
  }
}
