untName: string;\n  bankName: string;\n  branch: string;\n  accountNumber: string;\n  ifsc: string;\n  loanAppNumber?: string;\n}\n\nexport interface FormConfig {\n  showPoc: boolean;\n  showBranch: boolean;\n  showDtrCode: boolean;\n  showSanctionedLoad: boolean;\n  showDiscomDiv: boolean;\n  showGoogleDocs: boolean;\n  showLocationLink: boolean;\n  showLoanAppNumber: boolean;\n  showFinancialStage: boolean;\n}\n"
