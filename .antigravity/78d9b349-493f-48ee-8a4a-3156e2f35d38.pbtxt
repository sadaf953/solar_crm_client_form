    instruction: "Replace banking section small toggle with simple and clear Keep/Skip buttons in App.tsx"
    replacement_infos {
      original_chunk {
        target_content: "              {/* SECTION: CUSTOMER BANKING INFO & FINANCING - SKIP OPTION */}\n              <div className=\"bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6\">\n                <div className=\"pb-4 border-b border-slate-100 flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <Building2 className=\"w-5 h-5 text-teal-600\" />\n                    <h3 className=\"text-base font-black uppercase tracking-wider text-slate-800\">\n                      7. Customer Banking & Loan Coordination Info\n                    </h3>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => setBankInfoEnabled(!bankInfoEnabled)}\n                    className={`px-4 py-1.5 text-xs font-bold rounded-xl border transition-all ${\n                      bankInfoEnabled\n                        ? \'bg-teal-100 text-teal-800 border-teal-200\'\n                        : \'bg-slate-100 text-slate-400 border-slate-200\'\n                    }`}\n                  >\n                    {bankInfoEnabled ? \'Banking Enabled\' : \'Skipped / Omitted\'}\n                  </button>\n                </div>\n\n                <div className=\"bg-slate-50 border border-slate-200 rounded-2xl p-4 text-xs text-slate-500\">\n                  <p className=\"font-semibold text-slate-800 mb-1\">\360\237\222\241 Customer Banking and Loan Application Coordination Info</p>\n                  As requested by default, this module is set to <strong>Omitted</strong>, keeping your CRM lighter. If your sales staff handles coordinating third-party consumer credit/loans or direct recipient bank payouts, you can toggle it back on.\n                </div>\n\n                {bankInfoEnabled && (\n                  <div className=\"space-y-2.5 animate-fade-in\">\n                    {sections.find(s => s.id === \'bank_info\')?.fields.map(field => (\n                      <div key={field.id} className=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between gap-4\">\n                        <div>\n                          <span className=\"text-xs font-bold text-slate-800 block\">{field.label}</span>\n                          <span className=\"text-[10.5px] text-slate-500\">{field.description}</span>\n                        </div>\n                        <button\n                          type=\"button\"\n                          onClick={() => handleToggleField(\'bank_info\', field.id, !field.included)}\n                          className={`text-[10px] font-bold px-2.5 py-1.5 rounded transition border ${\n                            field.included\n                              ? \'bg-teal-50 text-teal-700 border-teal-200\'\n                              : \'bg-white text-slate-400 border-slate-200 line-through\'\n                          }`}\n                        >\n                          {field.included ? \'Approved\' : \'Omitted\'}\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>"
        replacement_content: "              {/* SECTION: CUSTOMER BANKING INFO & FINANCING - SKIP OPTION */}\n              <div className=\"bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-6\">\n                <div className=\"pb-4 border-b border-slate-100 flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2\">\n                    <Building2 className=\"w-5 h-5 text-teal-600\" />\n                    <h3 className=\"text-base font-black uppercase tracking-wider text-slate-800\">\n                      7. Customer Banking & Loan Coordination Info\n                    </h3>\n                  </div>\n                </div>\n\n                <div className=\"flex flex-col sm:flex-row gap-3 pt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setBankInfoEnabled(true)}\n                    className={`flex-1 px-4 py-3 rounded-2xl text-xs font-bold border transition text-center ${\n                      bankInfoEnabled\n                        ? \'bg-teal-600 text-white border-teal-600 shadow-sm\'\n                        : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-50\'\n                    }`}\n                  >\n                    \360\237\217\246 Yes, Keep Banking & Loan Details\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setBankInfoEnabled(false)}\n                    className={`flex-1 px-4 py-3 rounded-2xl text-xs font-bold border transition text-center ${\n                      !bankInfoEnabled\n                        ? \'bg-rose-600 text-white border-rose-600 shadow-sm\'\n                        : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-50\'\n                    }`}\n                  >\n                    \342\217\255\357\270\217 No, Skip Banking Details\n                  </button>\n                </div>\n\n                {bankInfoEnabled ? (\n                  <div className=\"space-y-2.5 animate-fade-in pt-2\">\n                    <p className=\"text-xs text-slate-500\">\n                      Specify which customer bank details and loan documents your team needs to collect and track inside the CRM:\n                    </p>\n                    {sections.find(s => s.id === \'bank_info\')?.fields.map(field => (\n                      <div key={field.id} className=\"p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between gap-4\">\n                        <div>\n                          <span className=\"text-xs font-bold text-slate-800 block\">{field.label}</span>\n                          <span className=\"text-[10.5px] text-slate-500\">{field.description}</span>\n                        </div>\n                        <button\n                          type=\"button\"\n                          onClick={() => handleToggleField(\'bank_info\', field.id, !field.included)}\n                          className={`text-[10px] font-bold px-2.5 py-1.5 rounded transition border ${\n                            field.included\n                              ? \'bg-teal-50 text-teal-700 border-teal-200\'\n                              : \'bg-white text-slate-400 border-slate-200 line-through\'\n                          }`}\n                        >\n                          {field.included ? \'Approved\' : \'Omitted\'}\n                        </button>\n                      </div>\n                    ))}\n                  </div>\n                ) : (\n                  <div className=\"text-center py-6 bg-slate-50 border border-slate-200 rounded-2xl\">\n                    <p className=\"text-xs text-slate-500 font-semibold\">You have bypassed the Customer Banking Details & Loan module.</p>\n                  </div>\n                )}\n              </div>"
      }
      num_matches: 1
    }
